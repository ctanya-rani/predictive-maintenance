# Backend
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# Database (optional; currently in-memory only)
DATABASE_URL=postgresql://user:password@localhost:5432/trainwatch

# Redis cache (optional)
REDIS_URL=redis://localhost:6379/0

# Frontend API URL
VITE_API_URL=http://localhost:5000

# Error tracking
SENTRY_DSN=https://key@sentry.io/project-id

# Email notifications (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=trainwatch@example.com
ALERT_EMAIL=ops@example.com

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration
PAGERDUTY_INTEGRATION_KEY=your-integration-key

# TrainWatch simulation parameters
TRAINWATCH_DAYS=14
TRAINWATCH_SEED=20260717

# Logging
LOG_LEVEL=INFO
